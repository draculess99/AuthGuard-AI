# AuthGuard AI Configuration
# This file shows example environment variables. Copy to .env and fill in your values.
# Never commit .env with real secrets.

# ===== LLM Explanation Providers (optional) =====
# AuthGuard uses local rules and XGBoost by default. These enable optional narrative explanations.

# Groq Cloud (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== External Data Source (optional) =====
# Configure these to load de-identified external case records instead of bundled demos.

# AUTHGUARD_LIVE_DATA_URL=https://your-authorized-source.example/cases.json
# AUTHGUARD_LIVE_DATA_BEARER_TOKEN=
AUTHGUARD_LIVE_DATA_TIMEOUT=20
AUTHGUARD_LIVE_DATA_MAX_BYTES=5242880
AUTHGUARD_LIVE_DATA_MAX_RECORDS=5000
AUTHGUARD_ALLOW_PRIVATE_LIVE_URL=false

# ===== API Configuration =====
AUTHGUARD_API_PORT=5008

# Optional: path to persistent data directory (default: ./database)
# AUTHGUARD_DATA_DIR=/data/authguard

# ===== PayPal Sandbox (Demo Only) =====
# All cases, amounts, and records are SYNTHETIC DEMONSTRATION DATA ONLY.
# PayPal Sandbox environment: https://sandbox.paypal.com
# To enable PayPal Sandbox integration:
# 1. Create a Business account at https://www.paypal.com/signin
# 2. Log in to https://developer.paypal.com
# 3. Navigate to Apps & Credentials, select Sandbox
# 4. Create a Business app and copy the Client ID and Secret below
# 5. Set PAYPAL_MODE=sandbox (NOT "live" for this demo)

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Where PayPal sends the buyer after approving or cancelling in the Sandbox
# (local Streamlit dashboard by default)
PAYPAL_RETURN_URL=http://localhost:8501
PAYPAL_CANCEL_URL=http://localhost:8501

# Example:
# PAYPAL_CLIENT_ID=AZ7v9t3O_K2vY8N...
# PAYPAL_CLIENT_SECRET=EGtR6w4P_J5xM9Q...
